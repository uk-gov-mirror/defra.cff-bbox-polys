{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "CDP Node.js Frontend Template"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <ul class="govuk-list">
        {% for route in routes %}
          <li>
            <a href="{{ route.href }}" class="govuk-link govuk-!-font-size-19 govuk-!-font-weight-bold">{{ route.text }}</a>
            <p class="govuk-body govuk-!-margin-top-1 govuk-!-margin-bottom-3 govuk-!-color-secondary">{{ route.description }}</p>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endblock %}
